generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String    @unique // clerk user id
  email         String    @unique
  name          String?
  imageUrl      String?
  industry      String?    // Combined industry-subindustry (e.g., "tech-software-development")
  industryInsight IndustryInsight? @relation(fields: [industry], references: [industry])
  // Dream Company Mode — validated slug from DREAM_COMPANIES (Google, OpenAI,
  // …). NOT a FK to CompanyProfile (profile is generated lazily on-demand); this
  // is a plain string so the user can set a target before any profile exists.
  targetCompany String?
  companyProfile CompanyProfile? @relation(fields: [targetCompany], references: [company])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile fields
  bio           String?
  experience    Int?      // Years of experience

  // Gamification — NovaScore streaks & XP. Bumped from server actions when
  // the user does something productive (completes a quiz, saves a resume,
  // logs an application, finishes a mock interview).
  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveAt  DateTime?

  // Subscription — set by the Razorpay checkout flow. `plan` is the
  // effective tier ("STARTER" | "PRO" | "TEAMS"); `currentPeriodEnd` drives
  // entitlement expiry; `razorpayCustomerId` holds the last successful
  // payment id (Razorpay has no persistent customer id for one-off orders).
  plan               String    @default("STARTER")
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  razorpayCustomerId String?
  paymentOrders      PaymentOrder[]

  // Relations
  skills        String[]  // Array of skills
  assessments   Assessment[]
  resume        Resume?
  coverLetter   CoverLetter[]
  applications  Application[]
  mockInterviews MockInterview[]
  digests       WeeklyDigest[]
  notifications Notification[]

  // ── Career OS ────────────────────────────────────────────────
  // Long-term-memory + timeline + persistent chat + coach insights.
  // All additive (nullable / default), so existing rows stay valid.
  preferredName      String?    // how the Coach + Twin address the user
  careerHealthScore  Json?      // cached CareerEngine.computeHealthScore result
  twinVersion        Int?       // last-built CareerTwin version (cache invalidation)
  memoryEntries      MemoryEntry[]
  timelineEvents     TimelineEvent[]
  chatSessions       ChatSession[]
  coachInsights      CoachInsight[]
  githubRepos        GitHubRepo[]
  careerTwin         CareerTwin?
  careerGoals        CareerGoal[]
  learningTopics     LearningTopic[]
  learningSessions   LearningSession[]
  structuredMemories StructuredMemory[]
  dreamCompanyPlan   DreamCompanyPlan?
}

// ── Career OS — long-term memory ─────────────────────────────────
// One row per durable fact the AI has learned about the user. `type` is one of
// MEMORY_TYPES (lib/constants.js); `content` is the human-readable memory;
// `structured` holds an optional typed payload ({ skill, level, evidence }).
// `tags` power keyword recall; `importance` (0..1) weights retrieval.
// `source`/`sourceId` make extraction idempotent (one memory per source row).
// `embedding` is an optional Float[] (pgvector-free; cosine computed in JS
// when EMBEDDINGS_ENABLED). `isForgotten` soft-hides a memory from recall.
model MemoryEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // MEMORY_TYPES: identity|career|interview|application|learning|project|github|preference|skill|achievement
  content     String    @db.Text
  structured  Json?
  tags        String[]  @default([])
  importance  Float     @default(0.5)
  source      String    @default("manual") // chat|interview|resume|application|github|quiz|mock|onboarding|manual|coach
  sourceId    String?
  embedding   Json?     // Float[] when EMBEDDINGS_ENABLED
  isForgotten Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([userId, isForgotten])
  @@index([userId, importance])
}

// ── Career OS — structured memory (Memory Engine) ────────────────
// Purpose-built, queryable, typed structured memories: the discrete career
// artifacts that don't have a dedicated model (Projects, Skills-as-records,
// Achievements, Certificates, Preferences, Resume Versions, Lessons/mistakes,
// Notes). `category` is one of STRUCTURED_MEMORY_CATEGORIES (lib/constants.js);
// `structured` holds the Zod-validated typed payload per category; `tags` +
// `importance` power keyword/tag retrieval ranking. `linkedType`/`linkedId`
// optionally point at a dedicated row (resume|mockInterview|assessment|
// application|learningTopic|goal) when the structured memory is derived from
// one, so the retrieval engine can dedupe across sources. Retrieval is
// keyword/tag/importance/recency based (no vectors); pg_trgm GIN indexes on
// title/summary/tags (added via raw-SQL migration) power fast ILIKE + overlap.
// `isArchived` soft-hides a row from retrieval (the curated equivalent of
// MemoryEntry.isForgotten). Idempotent on (userId, source, sourceId) when a
// source row is provided (mirrors MemoryEntry).
model StructuredMemory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // STRUCTURED_MEMORY_CATEGORIES: project|skill|achievement|certificate|preference|resume_version|lesson|note
  title       String
  summary     String?                 // one-line WHY / context
  detail      String?  @db.Text       // rich long-form
  structured  Json?                   // Zod-validated typed payload per category
  tags        String[] @default([])
  importance  Float    @default(0.5)  // 0..1, boosts retrieval rank
  source      String   @default("manual") // manual|ai-extracted|import|resume|mock|...
  sourceId    String?
  linkedType  String?  // resume|mockInterview|assessment|application|learningTopic|goal
  linkedId    String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isArchived])
  @@index([userId, importance])
}

// ── Career OS — auto-generated career timeline ───────────────────
// One row per career activity, derived from existing data (resume, application,
// mock interview, quiz, cover letter, chat) + new activity. `type` is one of
// TIMELINE_TYPES. `sourceType`/`sourceId` make derivation idempotent.
model TimelineEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // TIMELINE_TYPES: learning|building|applying|interviewing|offer|rejection|achievement|coach|github|milestone
  title       String
  description String?   @db.Text
  occurredAt  DateTime
  metadata    Json?
  sourceType  String    // resume|application|mockInterview|assessment|chat|github|learning|memory|manual
  sourceId    String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, occurredAt])
  @@index([userId, type])
}

// ── Career OS — persistent chat ("ChatGPT with career memory") ──
// A ChatSession groups ChatMessages; the Coach surface shows a sessions
// sidebar. `data` on each message holds { agentIds, sources, citations,
// followUps } so the UI can render memory chips + agent badges.
model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New conversation")
  archived  Boolean   @default(false)
  messages  ChatMessage[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, archived])
}

model ChatMessage {
  id        String    @id @default(cuid())
  userId    String    // denormalized for ownership queries; cascades via session.user
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String    // SESSION_ROLES: user|assistant|system
  content   String    @db.Text
  data      Json?     // { agentIds, sources, citations, followUps }
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([sessionId, createdAt])
}

// ── Career OS — proactive coach insights ────────────────────────
// Generated by the Coach agent / weekly digest cron. `kind` drives the icon;
// `severity` drives the color. `isRead`/`isActioned` track engagement.
model CoachInsight {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String    // COACH_INSIGHT_KINDS: nudge|progress|risk|recommendation|celebration
  title      String
  body       String?   @db.Text
  severity   String    @default("info") // COACH_SEVERITIES: info|warn|good|critical
  href       String?
  data       Json?
  isRead     Boolean   @default(false)
  isActioned Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ── Career OS — GitHub Project Analyzer (M7) ───────────────────
// One row per connected repository. `fullName` is owner/repo. `patHash` is the
// sha256 of a user-supplied Personal Access Token (null for public repos — no
// PAT needed). The PAT itself is NEVER stored: it travels only in the
// `github/repo.connected` Inngest event payload, the job uses it once to fetch
// the tree + key files, then discards it. `analysis` holds the Senior-Engineer
// 6-section review JSON; `analysisStatus` drives the UI badge.
model GitHubRepo {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String    // owner/repo
  provider       String    @default("github")
  patHash        String?   // sha256 of the PAT; null for public repos
  defaultBranch  String?
  description    String?
  language       String?
  stars          Int?
  isPrivate      Boolean   @default(false)
  analysis       Json?     // 6-section Senior-Engineer review
  analysisStatus String    @default("pending") // GITHUB_ANALYSIS_STATUS
  analysisError  String?
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, fullName])
  @@index([userId])
}

// ── Career OS — AI Career Twin (M8) ─────────────────────────────
// One row per user (userId @unique). `profile` is the synthesized twin JSON
// built from all non-forgotten memory + resume + GitHub + recent mocks +
// applications (see twinBuildPrompt). `version` is bumped on each rebuild so
// the UI/Coach can detect a stale twin. The twin answers questions in the
// user's voice via twinChatPrompt.
model CareerTwin {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      Json
  version      Int       @default(1)
  lastUpdatedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// ── Career OS — Learning Engine (M9) ─────────────────────────────
// A user's active career goal drives learning recommendations + the dashboard
// GoalCard. `status` is active|achieved|retired. One active goal at a time is
// enforced in the action layer (retiring the prior goal on set).
model CareerGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole  String
  targetLevel String?
  timeframe   String?
  rationale   String?   @db.Text
  status      String    @default("active") // GOAL_STATUSES: active|achieved|retired
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// A skill/topic the user is learning. `status` is todo|learning|learned|needs_review;
// `proficiency` (0..1) feeds the Career Health learning pillar (M9).
model LearningTopic {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill         String
  status        String    @default("todo") // LEARNING_TOPIC_STATUSES
  proficiency   Float     @default(0)
  notes         String?   @db.Text
  resources     Json?
  lastTouchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      LearningSession[]

  @@index([userId])
  @@index([userId, status])
}

// A single learning activity (quiz / mock / chat / resource / project) tied
// optionally to a topic. Drives the timeline + memory + the learning pillar.
model LearningSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       LearningTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  kind        String    // quiz | mock | chat | resource | project
  sourceId    String?
  summary     String?   @db.Text
  outcome     Json?
  durationMin Int?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, topicId])
  @@index([userId, createdAt])
}

model Assessment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  quizScore     Float     // Overall quiz score
  questions     Json[]    // Array of {question, answer, userAnswer, isCorrect}
  category      String    // "Technical", "Behavioral", etc.
  company       String?   // Dream Company slug when the quiz was company-tailored
  improvementTip String?  // AI-generated improvement tip
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Resume {
  id          String    @id @default(cuid())
  userId      String    @unique    // One resume per user
  user        User      @relation(fields: [userId], references: [id])
  content     String    @db.Text // Markdown content
  atsScore    Float?
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CoverLetter {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  content         String    // Markdown content
  jobDescription  String?
  companyName     String    // Name of the company applying to
  jobTitle        String    // Position applying for
  status          String    @default("draft") // draft, completed
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

// Combined Industry Trends and Salary Insights
model IndustryInsight {
  id            String    @id @default(cuid())
  industry      String    @unique  // The industry this data belongs to (e.g., "tech-software-development")
  
  // Users in this industry
  users         User[]
  
  // Salary data
  salaryRanges  Json[]    // Array of { role: string, min: float, max: float, median: float, location: string? }
  
  // Industry trends
  growthRate    Float     // Industry growth rate
  demandLevel   String    // "High", "Medium", "Low"
  topSkills     String[]  // Most in-demand skills
  
  // Market conditions
  marketOutlook String    // "Positive", "Neutral", "Negative"
  keyTrends     String[]  // Array of current industry trends
  
  // Learning suggestions
  recommendedSkills String[]  // Skills recommended for the industry
  
  lastUpdated   DateTime  @default(now())
  nextUpdate    DateTime  // Scheduled update time

  @@index([industry])
}

// ── Dream Company Mode ─────────────────────────────────────────
// Company-grained market + interview knowledge for one of the 8 dream
// companies (Google, OpenAI, …). Mirrors IndustryInsight: generated on-demand
// (upsert in getOrGenerateCompanyProfile) + refreshed by the weekly
// `generateCompanyProfiles` Inngest cron. `company` is the slug from
// DREAM_COMPANIES; `displayName` is the human label.
model CompanyProfile {
  id                String   @id @default(cuid())
  company           String   @unique  // slug from DREAM_COMPANIES (the FK target)
  displayName       String

  // Salary data — rendered directly (rule-based, no AI), mirrors IndustryInsight.
  salaryRanges      Json[]    // Array of { role, min, max, median, location? }

  // Skills this company hires for / expects
  topSkills         String[]
  recommendedSkills String[]

  // Interview knowledge — themes per round + famous questions to lean into
  interviewThemes   Json?     // [{ round, focus, examples[] }]
  famousQuestions   String[]
  values            String[]  // culture tenets (e.g. "Customer obsession")
  bar               String?   // hiring-bar summary
  keyTrends         String[]

  raw               Json?     // full model response, kept for debugging/audit
  lastUpdated       DateTime  @default(now())
  nextUpdate        DateTime  // scheduled refresh time

  users             User[]

  @@index([company])
}

// One personalized 7-area Dream Company plan per user, cached. Regenerated
// when the user changes their target company, when stale (>7d via nextUpdate),
// or via the "Regenerate" button. `plan` is the 7-area JSON from
// dreamCompanyPlanPrompt — each item carries a `why` grounded in the
// candidate's background + the company's bar/values.
model DreamCompanyPlan {
  id          String   @id @default(cuid())
  userId      String   @unique  // one plan per user
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String   // slug the plan was generated for
  plan        Json     // the 7-area object
  generatedAt DateTime @default(now())
  nextUpdate  DateTime // generatedAt + 7d

  @@index([userId])
}

// Job-application pipeline tracker. Each application can optionally link to
// the resume version and cover letter used, and store an ATS match score
// against its job description.
model Application {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  role           String
  location       String?
  salary         String?
  jobUrl         String?
  jobDescription String?   @db.Text
  status         String    @default("SAVED") // SAVED | APPLIED | SCREENING | INTERVIEW | OFFER | REJECTED
  resumeId       String?
  coverLetterId  String?
  notes          String?   @db.Text
  atsScore       Float?
  atsFeedback    String?   @db.Text
  // Career OS (M6) — outcome context for the two terminal statuses.
  rejectionReason String? @db.Text
  offerDetails    Json?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// In-app notifications — persistent event feed surfaced via the header bell
// and the /notifications page. `type` drives the icon + color in the UI;
// `data` holds optional structured context (score, company, stage). Created
// fire-and-forget from server actions at milestone events via the
// createNotification helper (lib/notifications.js).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // welcome | insights_ready | quiz_completed | mock_scored | cover_letter_ready | application_logged | application_advanced | application_rejected | ats_score | payment_success | weekly_digest | industry_changed
  title     String
  body      String?
  href      String?  // deep link, e.g. "/applications"
  data      Json?    // optional payload (score, company, stage)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

// Voice/text mock-interview sessions. `transcript` is the turn-by-turn
// conversation; `score`/`feedback` are AI-generated at the end of the session.
// `feedback` is JSON-stringified for back-compat; the denormalized fields below
// mirror its structured shape so the Career OS can query them without
// re-parsing (Interview Memory trend analysis, M6). All additive/nullable.
model MockInterview {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  industry    String?
  company     String?   // Dream Company slug when the session was company-tailored
  transcript  Json      // [{ role: "interviewer" | "candidate", text }]
  score       Float?
  feedback    String?   @db.Text
  // Denormalized from `feedback` (additive — old rows stay valid without them):
  questions             Json?     // array of { question, answer, score }
  strengths             String[]  @default([])
  improvements          String[]  @default([])
  communicationScore    Float?
  technicalDepthScore   Float?
  structureScore        Float?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Weekly AI career digest — one per user per ISO week. Generated by the
// Inngest cron. `content` is the structured digest payload (trending skills,
// salary movement, practice question, resume tweak suggestion).
model WeeklyDigest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  content     Json
  createdAt   DateTime  @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

// Razorpay payment orders — one row per checkout attempt. Created before the
// Razorpay modal opens (status "created"), updated to "paid" once the client
// posts back a verified signature. `amount` is in paise; `billingCycle` is
// "monthly" | "annual". Acts as the audit trail for every plan purchase.
model PaymentOrder {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   // "PRO" | "TEAMS"
  billingCycle      String   // "monthly" | "annual"
  amount            Int      // paise
  currency          String   @default("INR")
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            String   @default("created") // created | paid | failed
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}