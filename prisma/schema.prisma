generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  clerkUserId   String    @unique
  email         String    @unique
  name          String?
  imageUrl      String?
  industry      String?
  industryInsight IndustryInsight? @relation(fields: [industry], references: [industry])
  targetCompany String?
  companyProfile CompanyProfile? @relation(fields: [targetCompany], references: [company])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bio           String?
  experience    Int?

  xp            Int       @default(0)
  streak        Int       @default(0)
  lastActiveAt  DateTime?

  plan               String    @default("STARTER")
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  razorpayCustomerId String?
  paymentOrders      PaymentOrder[]

  skills        String[]
  assessments   Assessment[]
  resume        Resume?
  coverLetter   CoverLetter[]
  applications  Application[]
  mockInterviews MockInterview[]
  digests       WeeklyDigest[]
  notifications Notification[]

  preferredName      String?
  careerHealthScore  Json?
  twinVersion        Int?
  memoryEntries      MemoryEntry[]
  timelineEvents     TimelineEvent[]
  chatSessions       ChatSession[]
  coachInsights      CoachInsight[]
  githubRepos        GitHubRepo[]
  careerTwin         CareerTwin?
  careerGoals        CareerGoal[]
  learningTopics     LearningTopic[]
  learningSessions   LearningSession[]
  structuredMemories StructuredMemory[]
  dreamCompanyPlan   DreamCompanyPlan?
}

model MemoryEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  content     String    @db.Text
  structured  Json?
  tags        String[]  @default([])
  importance  Float     @default(0.5)
  source      String    @default("manual")
  sourceId    String?
  embedding   Json?
  isForgotten Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@index([userId, isForgotten])
  @@index([userId, importance])
}

model StructuredMemory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  title       String
  summary     String?
  detail      String?  @db.Text
  structured  Json?
  tags        String[] @default([])
  importance  Float    @default(0.5)
  source      String   @default("manual")
  sourceId    String?
  linkedType  String?
  linkedId    String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, category])
  @@index([userId, isArchived])
  @@index([userId, importance])
}

model TimelineEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String?   @db.Text
  occurredAt  DateTime
  metadata    Json?
  sourceType  String
  sourceId    String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, occurredAt])
  @@index([userId, type])
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New conversation")
  archived  Boolean   @default(false)
  messages  ChatMessage[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, archived])
}

model ChatMessage {
  id        String    @id @default(cuid())
  userId    String
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String    @db.Text
  data      Json?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([sessionId, createdAt])
}

model CoachInsight {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String?   @db.Text
  severity   String    @default("info")
  href       String?
  data       Json?
  isRead     Boolean   @default(false)
  isActioned Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model GitHubRepo {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  provider       String    @default("github")
  patHash        String?
  defaultBranch  String?
  description    String?
  language       String?
  stars          Int?
  isPrivate      Boolean   @default(false)
  analysis       Json?
  analysisStatus String    @default("pending")
  analysisError  String?
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, fullName])
  @@index([userId])
}

model CareerTwin {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      Json
  version      Int       @default(1)
  lastUpdatedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model CareerGoal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole  String
  targetLevel String?
  timeframe   String?
  rationale   String?   @db.Text
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model LearningTopic {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill         String
  status        String    @default("todo")
  proficiency   Float     @default(0)
  notes         String?   @db.Text
  resources     Json?
  lastTouchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      LearningSession[]

  @@index([userId])
  @@index([userId, status])
}

model LearningSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       LearningTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  kind        String
  sourceId    String?
  summary     String?   @db.Text
  outcome     Json?
  durationMin Int?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, topicId])
  @@index([userId, createdAt])
}

model Assessment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  quizScore     Float
  questions     Json[]
  category      String
  company       String?
  improvementTip String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Resume {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  content     String    @db.Text
  atsScore    Float?
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CoverLetter {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  content         String
  jobDescription  String?
  companyName     String
  jobTitle        String
  status          String    @default("draft")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
}

model IndustryInsight {
  id            String    @id @default(cuid())
  industry      String    @unique
  
  users         User[]
  
  salaryRanges  Json[]
  
  growthRate    Float
  demandLevel   String
  topSkills     String[]
  
  marketOutlook String
  keyTrends     String[]
  
  recommendedSkills String[]
  
  lastUpdated   DateTime  @default(now())
  nextUpdate    DateTime

  @@index([industry])
}

model CompanyProfile {
  id                String   @id @default(cuid())
  company           String   @unique
  displayName       String

  salaryRanges      Json[]

  topSkills         String[]
  recommendedSkills String[]

  interviewThemes   Json?
  famousQuestions   String[]
  values            String[]
  bar               String?
  keyTrends         String[]

  raw               Json?
  lastUpdated       DateTime  @default(now())
  nextUpdate        DateTime

  users             User[]

  @@index([company])
}

model DreamCompanyPlan {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  plan        Json
  generatedAt DateTime @default(now())
  nextUpdate  DateTime

  @@index([userId])
}

model Application {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  role           String
  location       String?
  salary         String?
  jobUrl         String?
  jobDescription String?   @db.Text
  status         String    @default("SAVED")
  resumeId       String?
  coverLetterId  String?
  notes          String?   @db.Text
  atsScore       Float?
  atsFeedback    String?   @db.Text
  rejectionReason String? @db.Text
  offerDetails    Json?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  href      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model MockInterview {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  industry    String?
  company     String?
  transcript  Json
  score       Float?
  feedback    String?   @db.Text
  questions             Json?
  strengths             String[]  @default([])
  improvements          String[]  @default([])
  communicationScore    Float?
  technicalDepthScore   Float?
  structureScore        Float?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model WeeklyDigest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime
  content     Json
  createdAt   DateTime  @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

model PaymentOrder {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String
  billingCycle      String
  amount            Int
  currency          String   @default("INR")
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  razorpaySignature String?
  status            String   @default("created")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}